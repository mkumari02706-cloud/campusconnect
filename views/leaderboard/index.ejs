<!DOCTYPE html>
<html>
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container">
    <h1>Peer Leaderboard</h1>
    <table>
      <tr><th>Rank</th><th>Name</th><th>Score</th></tr>
      <% topUsers.forEach((u, i) => { %>
        <tr><td><%= i + 1 %></td><td><%= u.name %></td><td><%= u.contributionScore %></td></tr>
      <% }) %>
    </table>
  </div>
</body>
</html>