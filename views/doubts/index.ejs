<!DOCTYPE html>
<html>
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container">
    <h1>Study Communities</h1>
    <a href="/doubts/new" class="btn">+ Ask a Doubt</a>
    <div style="margin-top: 1.5rem;">
      <% doubts.forEach(d => { %>
        <div class="card">
          <a href="/doubts/<%= d._id %>"><h3><%= d.title %></h3></a>
          <p class="meta"><%= d.subject %> · <%= d.isAnonymous ? "Anonymous" : "Posted" %> · <%= d.upvotes %> upvotes</p>
        </div>
      <% }) %>
      <% if (doubts.length === 0) { %>
        <div class="empty-state">No doubts yet. Be the first to ask!</div>
      <% } %>
    </div>
  </div>
</body>
</html>