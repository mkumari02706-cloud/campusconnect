<!DOCTYPE html>
<html>
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container">
    <h1>Ask a Doubt</h1>
    <form action="/doubts" method="POST">
      <input type="text" name="title" placeholder="Doubt title" required />
      <input type="text" name="subject" placeholder="Subject" required />
      <textarea name="description" placeholder="Describe your doubt" required></textarea>
      <label><input type="checkbox" name="isAnonymous" /> Post anonymously</label>
      <button type="submit" class="btn">Post Doubt</button>
    </form>
  </div>
</body>
</html>