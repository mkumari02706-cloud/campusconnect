<!DOCTYPE html>
<html>
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container">
    <h1><%= doubt.title %></h1>
    <p class="meta"><%= doubt.subject %> · <%= doubt.isAnonymous ? "Anonymous" : "Posted" %></p>
    <p><%= doubt.description %></p>

    <form action="/doubts/<%= doubt._id %>/upvote" method="POST">
      <button type="submit" class="btn">Upvote (<%= doubt.upvotes %>)</button>
    </form>

    <h2>Replies</h2>
    <% (doubt.replies || []).forEach(r => { %>
      <div class="card"><p><%= r.text %></p></div>
    <% }) %>

    <form action="/doubts/<%= doubt._id %>/replies" method="POST">
      <textarea name="text" placeholder="Write a reply" required></textarea>
      <button type="submit" class="btn">Reply</button>
    </form>

    <form action="/doubts/<%= doubt._id %>/delete" method="POST">
      <button type="submit" class="btn" style="background:#c0392b;">Delete Doubt</button>
    </form>

    <div style="margin-top: 1.5rem;">
       <a href="/doubts" class="btn btn-outline" style="color:#2e86ab; border-color:#2e86ab; background:white;">← Back to all doubts</a>
     </div>
  </div>
</body>
</html>